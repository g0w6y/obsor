<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Obsor.Pro</RootNamespace>
    <AssemblyName>obsor-pro</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>obsor-pro</ToolCommandName>
    <PackageId>Obsor.Pro</PackageId>
    <Version>1.0.0</Version>
    <Authors>g0w6y</Authors>
    <Description>Hardened external-key PRO tier of the Obsor obfuscation toolkit: Roslyn-compiled payload, AES-256-GCM, Argon2id key derivation, honestly measured against this repo's own output.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/g0w6y/obsor</RepositoryUrl>
    <PackageProjectUrl>https://github.com/g0w6y/obsor</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
